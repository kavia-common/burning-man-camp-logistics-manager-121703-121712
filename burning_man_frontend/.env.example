# PUBLIC CONFIG (copy to .env at the root of burning_man_frontend)
# Base URL for backend REST API, e.g. https://api.example.com
REACT_APP_API_BASE_URL=

# Optional: used for signup email redirect flows (future authentication integrations)
REACT_APP_SITE_URL=http://localhost:3000

# Optional: Venmo username to link payments from Dues page
REACT_APP_VENMO_USERNAME=
